generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------- MODELS ------------------------

// App Users

model User {
    userId String @id 
    firstName String
    lastName String
    email String
    profileImage String?
    isAdmin Boolean @default(false) //can be discarded if not needed, 

    requestedVendorRequests VendorRequest[] @relation("requestedVendorRequest") //vendor request by the user on behalf of their firm
    installedListings InstalledListing[] //listings installed by the user
    requestedListings ListingAccessControl[] @relation("requestedListings") //listings requested by the user on behalf of firm

    actionedListingRequests ListingAccessControl[] @relation("actionedRequest") //user approving/rejecting listing requests on behalf of their firm (for audit trail purposes)

    approvedVendorRequests VendorRequest[] @relation("actionedVendorRequest") //user approving/rejecting vendor requests on behalf of their firm - done by an admin user

    updatedListings Listing[] 
    savedListing SavedListing[]

    // GlobalWhitelistActions FirmWhitelist[]  //a user adding other firms in their current firm's (which is a vendor) global whitelist
}

model Firm {
    firmId String @id 
    firmName String
    isVendor Boolean @default(false)
    vendorStatus VendorStatus?
    vendorProfile VendorProfile?

    //Case: Firm as a user of the marketplace
    installedListings InstalledListing[]
    requestedListings ListingAccessControl[]
    vendorRequest VendorRequest? //if the firm

    //firm as a vendor - having listings in the marketplace
    createdListings Listing[]   
}

//table to track listing requests and their status
model ListingAccessControl {
    id String @id @default(uuid())
    requestedByFirmId String
    requestedByUserId String
    listingId String
    actionedByUserId String? 
    requestStatus RequestStatus @default(pending)
    requestTime DateTime @default(now())
    actionTime DateTime @updatedAt

    requestingFirm Firm @relation(fields: [requestedByFirmId], references: [firmId])
    requestingUser User @relation("requestedListings", fields: [requestedByUserId], references: [userId] )

    listing Listing @relation(fields: [listingId], references: [id]) //requested listing
    actionedBy User? @relation("actionedRequest", fields: [actionedByUserId], references: [userId])

    @@unique([listingId, requestedByFirmId])
}

