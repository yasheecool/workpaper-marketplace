model VendorProfile {
    firmId String @id
    firmEmail String
    firmLogo String?
    description String
    vendorSince DateTime @default(now())
    websiteUrl String
    linkedInUrl String?
    vendor Firm @relation(fields: [firmId], references: [firmId])
}

model VendorRequest {
  requestId String @id @default(uuid())
  requestingFirmId String @unique
  requestedByUserId String
  requestStatus RequestStatus @default(pending)
  requestedAt DateTime @default(now())
  actionedAt DateTime?
  actionedBy String?
  contactEmail String
  contactPhone String

  requestedByUser User @relation(fields: [requestedByUserId], references: [userId], name: "requestedVendorRequest")
  requestedByFirm Firm @relation(fields: [requestingFirmId], references: [firmId])
  actionedByUser User? @relation(fields: [actionedBy], references: [userId], name: "actionedVendorRequest")
}

// ------------------- ENUMS ------------------------

enum VendorStatus {
  active
  blocked
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum ListingVisibility {
  public
  request_access
  private
}

enum Region {
  australia
  newZealand
  unitedKingdom
  republicOfIreland
}

enum WorkpaperType {
  compliance
  itr
  bas
  taxPlanning
  fbt
}

enum EntityType {
  company
  individual
  partnership
  trust
}

enum ListingType {
  calculation
  checklist
  report
  procedure
  wiki
}

enum ListingStatus {
  active
  deleted
}
