model SavedListing {
    id String @id @default(uuid())
    savedByUserId String
    listingId String
    saveTime DateTime @default(now())

    listing Listing @relation(fields: [listingId], references: [id])
    savedByUser User @relation(fields: [savedByUserId], references: [userId])
    @@unique([savedByUserId, listingId])
}

model InstalledListing {
    id String @id @default(uuid())
    installedByUserId String
    installedByFirmId String
    listingId String
    installTime DateTime @default(now())

    installedByUser User @relation(fields: [installedByUserId], references: [userId])
    installedByFirm Firm @relation(fields: [installedByFirmId], references: [firmId])
    listing Listing @relation(fields: [listingId], references: [id])

    @@unique([installedByFirmId, listingId])
}

model Listing {
    id String @id
    ownerFirmId String
    createdByUserId String
    updatedAt DateTime @updatedAt
    updatedByUserId String
    createdAt DateTime @default(now())
    name String
    description String
    longDescription String?
    gettingStartedSteps String?
    region Region
    contentType ListingType
    workpaperType WorkpaperType[]
    entityType EntityType[]
    tags String[]
    imagesLink String[] @default([])
    visibility ListingVisibility @default(public)
    status ListingStatus @default(active)

    // changelogs ListingChangeRecords[]
    installedBy InstalledListing[]
    savedBy SavedListing[]
    requestedBy ListingAccessControl[]
    ownedByFirm Firm @relation(fields: [ownerFirmId], references: [firmId])
    updatedBy User @relation(fields: [updatedByUserId], references: [userId])
}

