node_modules/
**/node_modules/

.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------
